# Node.js 24 / npm run dev: Web 5173, API 3001
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/dialogria.sqlite
STORAGE_ROOT=./storage
# 本番は各32文字以上のランダム値を設定。暗号化鍵の変更は保存済みAPIキーの再登録が必要。
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
# ブラウザへ渡さない。管理画面でも登録可能。
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=marin
GEMINI_API_KEY=
# 安定版の推奨初期値。実接続で利用権限を検証
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
DEFAULT_TEXT_PROVIDER=GEMINI
DEFAULT_VIDEO_PROVIDER=GEMINI
VIDEO_GENERATION_ENABLED=false
# 空欄は同梱バイナリ使用。字幕は日本語対応フォントを指定。
FFMPEG_PATH=
FFPROBE_PATH=
SUBTITLE_FONT=/System/Library/Fonts/ヒラギノ角ゴシック W3.ttc
# 管理者が許可したローカル接続先のみ (カンマ区切り)
LOCAL_PROVIDER_ORIGINS=http://127.0.0.1:11434,http://127.0.0.1:1234,http://127.0.0.1:50021
JOB_POLL_MS=1500
JOB_MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_MS=120000
EXPORT_RETENTION_DAYS=7

# OpenAI文章モデル。DEFAULT_TEXT_PROVIDER は GEMINI / OPENAI / OLLAMA / LM_STUDIO。
OPENAI_TEXT_MODEL=

# 初期管理者はメールと12文字以上のパスワードを設定すると起動時に1度だけ作成。
# 作成後は管理画面で変更。再起動や.envの変更では既存アカウントを上書きしません。
INITIAL_ADMIN_EMAIL=ui-test@dialogria.test
INITIAL_ADMIN_PASSWORD=zxcvfr45
INITIAL_ADMIN_DISPLAY_NAME=管理者

# AI講師の発話文字数上限（新規ルームの標準値、1〜4000文字）
AI_LECTURER_SPEECH_MAX_CHARS=200

# PDF出力の標準設定（管理画面の保存値を優先）
PDF_FONT=IPAexGothic
PDF_CODE_FONT=IPAexGothic
PDF_FONT_SIZE=11
PDF_PAGE_SIZE=A4
